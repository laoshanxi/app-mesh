#!/usr/bin/env bash
# 数字人技能调用 CLI —— agent 会话内（Bash 工具）与人工调试共用。
# 用法: skill <技能名，不带 team 前缀> '<JSON 参数>'
# 依赖: DH_TEAM（默认 demo）、APPMESH_URL / APPMESH_CA 与凭据二选一：
#       APPMESH_BEARER_TOKEN（静态 token），或 DH_BOT_PASSWORD_FILE + DH_BOT_USER
#       + DH_TOKEN_URL（SDK PasswordGrantProvider，重跑 setup.sh 自动生成）。
set -euo pipefail

NAME=${1:?usage: skill <name> '<json>'}
PAYLOAD="{}"
if [ $# -ge 2 ]; then
	PAYLOAD="$2"
fi
PKG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DH_TEAM="${DH_TEAM:-demo}"
export APPMESH_URL="${APPMESH_URL:-https://127.0.0.1:6060}"
export APPMESH_CA="${APPMESH_CA:-/opt/appmesh/ssl/ca.pem}"

# 统一用 venv 的 Python（appmesh SDK >= 3.0.10）：系统自带的旧版 SDK
# 对短中文响应会按 chardet 猜编码导致乱码
PY="$PKG_DIR/runtime/venv/bin/python"
[ -x "$PY" ] || PY=python3
exec "$PY" "$PKG_DIR/skills/call_skill.py" "$NAME" "$PAYLOAD"
